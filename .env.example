# Go 程序不会自动读取 .env；PowerShell 使用 $env:变量名='值'。
# Docker Compose 会读取 .env，用于 ${...} 插值。
AUTH_SECRET=replace-this-with-your-own-random-secret-at-least-32-bytes
STORE_MODE=mysql
ADDR=127.0.0.1:8080
MYSQL_DSN=seckill:local-seckill-only@tcp(127.0.0.1:13306)/seckill_lab
REDIS_ADDR=127.0.0.1:16379
MAX_INFLIGHT=64
RATE_LIMIT=200
